APP_NAME="dpay recon engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- BNP Paribas GOconnect Biznes -------------------------------------
# Certyfikat komunikacyjny (dwustronny SSL) - bez niego kanal nie istnieje.
BNP_CLIENT_ID=
BNP_INITIATING_PARTY=dpayrecon
BNP_CERT_PATH=
BNP_KEY_PATH=
BNP_KEY_PASSPHRASE=
# Pusty endpoint = produkcja. Adres testowy bank nadaje indywidualnie (HTTPS).
BNP_ENDPOINT=
BNP_CA_BUNDLE_PATH=
BNP_TIMEOUT_SECONDS=120
BNP_MESSAGE_ID_PREFIX=DPAY

# Certyfikat autoryzacyjny (podpis XAdES) - potrzebny dopiero przy zleceniach.
BNP_SIGN_PKCS12_PATH=
BNP_SIGN_PASSWORD=

# --- Maska masscollect ------------------------------------------------
# Numer rozliczeniowy i prefiks nadaje bank. Zmiana ktoregokolwiek z tych
# pol po wydaniu pierwszych numerow uniewaznia juz wydane rachunki.
BNP_MASSCOLLECT_BANK_CODE=16001462
BNP_MASSCOLLECT_CLIENT_PREFIX=0022
BNP_MASSCOLLECT_DOMAIN_DIGITS=1
BNP_MASSCOLLECT_MASTER_IBAN=
BNP_MASSCOLLECT_LOW_WATERMARK=1000

# --- Pobieranie danych z banku ----------------------------------------
BNP_HISTORY_LOOKBACK_DAYS=7
BNP_STATEMENT_FORMAT=XML
